# Base URL of the Spring Boot API — no trailing slash
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Google Gemini key. Server-side only — do NOT add a NEXT_PUBLIC_ prefix,
# it is read inside route handlers and must never reach the browser.
GEMINI_API_KEY=

# Optional — Web Push. Push is inert without it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional — shared secret so a cron job can call /api/send-push
PUSH_INTERNAL_SECRET=
